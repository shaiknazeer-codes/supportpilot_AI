# SupportPilot AI - Environment Configuration
# Copy this file to .env.local and populate with your credentials.
# NEVER commit .env.local or expose API keys/database credentials to client-side code.

# -----------------------------------------------------------------------------
# AI Provider Configuration (Server-Only)
# Priority:
# 1. If OPENROUTER_API_KEY is defined, the system connects to OpenRouter at
#    https://openrouter.ai/api/v1 using OPENROUTER_MODEL (supports free models like
#    meta-llama/llama-3.3-70b-instruct:free or google/gemini-2.0-flash-exp:free).
# 2. Otherwise, if OPENAI_API_KEY is defined, it connects to OpenAI (requires credits).
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# OpenAI API Configuration (Server-Only - Requires paid balance)
OPENAI_API_KEY=sk-proj-your-key-here
OPENAI_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# MongoDB Atlas Configuration (Server-Only)
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<database>?retryWrites=true&w=majority
# IMPORTANT: Ensure your IP (or 0.0.0.0/0) is whitelisted in MongoDB Atlas:
# Atlas Console -> Security -> Network Access -> Add IP Address
# -----------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://en25cs3090201_db_user:Munna_786@supportpilotcluster.pcsoao1.mongodb.net/
MONGODB_DB_NAME=supportpilot_user

# -----------------------------------------------------------------------------
# OpenWA WhatsApp Easy API Configuration (Server-Only)
# Connects to a separately running @open-wa/wa-automate Easy API server instance.
# Start OpenWA with:
#   npx @open-wa/wa-automate --easy-api --key YOUR_API_KEY --port 8080 --webhook http://localhost:3000/api/whatsapp/webhook
# -----------------------------------------------------------------------------
OPENWA_BASE_URL=http://localhost:8080
OPENWA_API_KEY=your_openwa_api_key_here
OPENWA_WEBHOOK_SECRET=your_openwa_api_key_here
